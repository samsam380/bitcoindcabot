# Copy to .env and fill in. Never commit the real .env.

# Binance API key — enable "Spot Trading" only.
# Leave withdrawals DISABLED and restrict the key to your server's IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram notifications (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DCA settings (all optional, defaults shown) ---
DCA_SYMBOL=BTCUSDT
DCA_AMOUNT=21

# Set only if you buy more than once a day, so each run gets its own
# idempotency key (e.g. "morning" / "evening").
#DCA_SLOT=

# Warn when fewer than this many buys of quote currency remain.
DCA_LOW_BALANCE_DAYS=7

# Nudge to withdraw once this much BTC sits on the exchange. 0 disables.
DCA_WITHDRAW_REMINDER=0.01

# Networking / reliability
DCA_RECV_WINDOW=10000
DCA_MAX_RETRIES=5

# Set to 1 to never place real orders.
#DCA_DRY_RUN=0

# File locations (default: next to the script)
#DCA_LOG_FILE=
#DCA_LEDGER_FILE=
